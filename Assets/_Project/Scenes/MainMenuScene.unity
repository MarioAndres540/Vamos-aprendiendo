  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b><color=#6B57DD>Objetivo</color></b>\nCamina por las islas, ac\xE9rcate
    al pulpo y elige una actividad. Traza las letras y los n\xFAmeros siguiendo el
    camino.\nCuando termines, abre el cofre para recibir tu experiencia.\n\n<b><color=#6B57DD>Controles</color></b>\n\u2022 
    <b>Joystick</b> (a la izquierda): mover al personaje\n\u2022  <b>Deslizar el
    dedo</b> por la derecha: girar la c\xE1mara\n\u2022  <b>Saltar</b>: bot\xF3n
    de salto\n\u2022  <b>Sonido</b>: activar o silenciar la m\xFAsica y los efectos\n\u2022 
    <b>Pausa</b>: detener el juego y volver cuando quieras\n\u2022  <b>?</b>: repetir
    el tutorial"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
